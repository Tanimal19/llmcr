{
  "name": "llmcr",
  "version": "0.0.0",
  "license": "MIT",
  "bin": "dist/cli.js",
  "type": "module",
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "prettier --check . && xo",
    "lint:fix": "prettier --write . && xo --fix",
    "test": "ava",
    "test:coverage": "c8 --reporter=lcov ava"
  },
  "imports": {
    "#components": {
      "development": "./source/components/index.js",
      "default": "./dist/components/index.js"
    },
    "#hooks": {
      "development": "./source/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "#*": {
      "development": "./source/*",
      "default": "./dist/*"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "ink": "^7.0.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@sindresorhus/tsconfig": "^8.1.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@vdemedes/prettier-config": "^2.0.1",
    "ava": "^8.0.1",
    "c8": "^11.0.0",
    "chalk": "^5.6.2",
    "eslint-config-xo-react": "^0.30.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ink-testing-library": "^4.0.0",
    "meow": "^14.1.0",
    "prettier": "^3.8.3",
    "sonarqube-scanner": "^3.5.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "xo": "^2.0.2"
  },
  "ava": {
    "extensions": [
      "ts",
      "tsx"
    ],
    "nodeArguments": [
      "--import=tsx",
      "--conditions=development"
    ]
  },
  "xo": {
    "prettier": true,
    "semicolon": true,
    "space": true,
    "rules": {
      "react/prop-types": "off",
      "unicorn/prevent-abbreviations": "off",
      "@typescript-eslint/naming-convention": "off"
    }
  }
}
