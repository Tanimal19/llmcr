    @Test
    void testEqualsAndHashCode() {
        OpenAiSdkChatOptions options1 = OpenAiSdkChatOptions.builder().model("test-model").temperature(0.7).maxTokens(100).build();
        OpenAiSdkChatOptions options2 = OpenAiSdkChatOptions.builder().model("test-model").temperature(0.7).maxTokens(100).build();
        OpenAiSdkChatOptions options3 = OpenAiSdkChatOptions.builder().model("different-model").temperature(0.7).maxTokens(100).build();
        // Test equals
        assertThat(options1).isEqualTo(options2);
        assertThat(options1).isNotEqualTo(options3);
        assertThat(options1).isNotEqualTo(null);
