        var userMessage = UserMessage.builder().text("Explain what do you see on this picture?").media(List.of(Media.builder().mimeType(MimeTypeUtils.IMAGE_PNG).data(URI.create("https://docs.spring.io/spring-ai/reference/_images/multimodal.test.png")).build())).build();
        ChatResponse response = this.chatModel.call(new Prompt(List.of(userMessage), OpenAiChatOptions.builder().model(modelName).build()));
