+ * @see SimpleVectorStoreFilterExpressionConverter
+ */
+@DisplayName("SimpleVectorStoreFilterExpressionConverter Security Tests - Issue #4545")
+class SimpleVectorStoreFilterExpressionConverterSecurityTests {
