+	 * Issue:  #4545 - Without escaping, SQL injection is possible
+	 * Security Risk: HIGH - Allows SQL injection attacks
+	 * </pre>
+	 */
+	@Test
+	@DisplayName("SQL injection attack should be prevented")
+	void testSqlInjectionAttack() {
