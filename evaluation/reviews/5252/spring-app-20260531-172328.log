+
+			assertThat(vectorStore.getNativeClient()).isPresent();
+			assertThat(vectorStore.getNativeClient().get()).isInstanceOf(BedrockAgentRuntimeClient.class);
+		});
+	}
+
+	@Test
+	void shouldReturnKnowledgeBaseId() {
