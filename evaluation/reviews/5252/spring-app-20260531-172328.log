+			VectorStore vectorStore = context.getBean(VectorStore.class);
+
+			assertThatThrownBy(() -> vectorStore.add(List.of())).isInstanceOf(UnsupportedOperationException.class);
+		});
+	}
+
+	@Test
+	void deleteShouldThrowUnsupportedOperationException() {
