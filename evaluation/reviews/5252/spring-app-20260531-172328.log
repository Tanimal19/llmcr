+
+			RetrievalFilter result = BedrockKnowledgeBaseFilterExpressionConverterTest.this.converter
+				.convertExpression(expr);
+
+			assertThat(result.equalsValue().value().asNumber().longValue()).isEqualTo(1704067200000L);
+		}
+
+	}
+
