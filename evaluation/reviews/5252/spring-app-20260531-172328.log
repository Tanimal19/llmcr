+	@BeforeEach
+	void setUp() {
+		this.vectorStore = BedrockKnowledgeBaseVectorStore.builder(this.mockClient, TEST_KB_ID)
+			.topK(5)
+			.similarityThreshold(0.7)
+			.build();
+	}
