+
+		/** The bucket name. */
+		private String bucketName;
+
+		/** The key prefix. */
+		private String keyPrefix;
+
+		/** Whether to initialize bucket. */
+		private boolean initializeBucket = false;
+
+		/** The storage class. */
+		private StorageClass storageClass;
+
+		/**
+		 * Private constructor.
+		 */
+		private Builder() {
+		}
+
+		/**
+		 * Sets the S3 client.
