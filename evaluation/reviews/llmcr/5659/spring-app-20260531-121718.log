+					Your response should be in JSON format.
+					The JSON Schema is:
+					```%s```
+					""".formatted(this.jsonSchema);
+		}
+
+		@Override
+		public String getJsonSchema() {
+			return this.jsonSchema;
+		}
+
+		@Override
+		public JsonNode convert(String source) {
+			return JsonParser.getJsonMapper().readTree(source);
+		}
+
