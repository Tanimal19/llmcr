+				assertThat(options.getModel()).isEqualTo("tts-1-hd");
+				assertThat(options.getVoice()).isEqualTo("nova");
+				assertThat(options.getResponseFormat()).isEqualTo("opus");
+				assertThat(options.getSpeed()).isEqualTo(1.5);
