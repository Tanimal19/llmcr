+		 * Builds the OpenAiSdkAudioSpeechModel instance.
+		 * @return A new OpenAiSdkAudioSpeechModel instance
+		 */
+		public OpenAiSdkAudioSpeechModel build() {
+			return new OpenAiSdkAudioSpeechModel(this);
+		}
+
+	}
+
+}
