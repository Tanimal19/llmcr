+		assertThat(response.getResult().getOutput()).isNotEmpty();
+	}
+
+	@Test
+	void testTts1HdModel() {
+		OpenAiSdkAudioSpeechOptions options = OpenAiSdkAudioSpeechOptions.builder()
+			.model("tts-1-hd")
