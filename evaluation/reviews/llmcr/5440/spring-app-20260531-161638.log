+
+		assertThat(options.getModel()).isEqualTo("gpt-4o-mini-tts");
+		assertThat(options.getVoice()).isEqualTo("alloy");
+		assertThat(options.getResponseFormat()).isEqualTo("mp3");
+		assertThat(options.getSpeed()).isEqualTo(1.0);
